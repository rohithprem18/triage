# LLM endpoint (OpenAI-compatible, with tool calling). Defaults to Sluice; any compatible
# endpoint works, e.g. TRIAGE_LLM_BASE_URL=https://api.groq.com/openai/v1 with model openai/gpt-oss-120b.
TRIAGE_LLM_BASE_URL=https://sluice-orcin.vercel.app/v1
TRIAGE_LLM_API_KEY=
TRIAGE_LLM_MODEL=sluice/smart

# Optional: shared rate limits for the public demo (in-memory without these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TRIAGE_RUNS_PER_HOUR=10
TRIAGE_RUNS_PER_DAY=150
